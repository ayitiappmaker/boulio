{
  "expo": {
    "name": "boulio",
    "slug": "boulio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/branding/boulio-app-icon.png",
    "scheme": "boulio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/branding/boulio-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080A0D",
        "foregroundImage": "./assets/images/branding/boulio-adaptive-foreground.png",
        "monochromeImage": "./assets/images/branding/boulio-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.luvme03.boulio"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FA",
          "image": "./assets/images/branding/boulio-splash.png",
          "imageWidth": 112
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d44864c-03dc-4a19-ae0c-8e4c475367a3"
      }
    }
  }
}
